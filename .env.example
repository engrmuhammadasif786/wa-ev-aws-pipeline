# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Buckets
S3_RAW_BUCKET=wa-ev-raw-data
S3_CURATED_BUCKET=wa-ev-curated-data

# Athena
ATHENA_DATABASE=wa_ev_db
ATHENA_TABLE=curated_ev_data
ATHENA_WORKGROUP=wa_ev_workgroup
ATHENA_S3_STAGING_DIR=s3://wa-ev-curated-data/athena-query-results/

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Optional: data.wa.gov API token (increases rate limits)
WADATA_APP_TOKEN=
